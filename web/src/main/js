            <i data-lucide="spa"></i>
            <h2>Welcome to Daywise</h2>
            <p>Let's set up your personalized health and nutrition targets with a quick onboarding quiz!</p>
          </div>
        ` : ''}

        ${step === 1 ? `
          <div class="onboarding-step">
            <h3>Tell us about yourself</h3>
