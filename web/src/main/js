// ── Gemini Integration ───────────────────────────────────────────────────────
const SYSTEM_PROMPT = `
You are a conversational health parser. Extract structured food or exercise details and return ONLY a valid raw JSON object. Do not include markdown code fences, extra text, or formatting.

If the input describes food, return:
{"type": "food", "items": [{"name": "Food Item Name", "calories": 250, "protein_g": 20.0, "carbs_g": 30.0, "fat_g": 5.0}]}

If the input describes exercise, return:
{"type": "exercise", "items": [{"name": "Workout Description", "duration_minutes": 30, "calories_burned": 240}]}

Rules:
- Estimate realistic numbers based on general science if exact weights are omitted.
- Support multiple items in one go (e.g. "2 eggs and toast" -> items array with two objects).
- Return ONLY the exact JSON, with absolutely no packaging or explainers.
`;

async function parseInputWithGemini(userText) {
  if (!state.apiKey) {
    // Simulated mock parser if no API Key entered
    return simulateMockParsing(userText);
  }

  try {
    const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${state.apiKey}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        contents: [{ parts: [{ text: `${SYSTEM_PROMPT}\n\nUser input: ${userText}` }] }],
        generationConfig: {
          temperature: 0.1,
          maxOutputTokens: 1024,
          responseMimeType: "application/json"
        }
      })
    });

    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    const data = await response.json();
    const rawJsonStr = data.candidates?.[0]?.content?.parts?.[0]?.text?.trim() || "";
    return JSON.parse(rawJsonStr);
  } catch (err) {
    console.error(err);
    return { type: "error", message: `AI connection failed: ${err.message}` };
  }
}

function simulateMockParsing(text) {
  const lower = text.toLowerCase();
  
  if (lower.includes('egg') || lower.includes('chicken') || lower.includes('rice') || lower.includes('banana') || lower.includes('shake') || lower.includes('toast') || lower.includes('apple') || lower.includes('salad') || lower.includes('coffee')) {
    const items = [];
    if (lower.includes('egg')) items.push({ name: "Scrambled Eggs (2)", calories: 140, protein_g: 12, carbs_g: 1, fat_g: 10 });
    if (lower.includes('chicken')) items.push({ name: "Grilled Chicken Breast (150g)", calories: 220, protein_g: 40, carbs_g: 0, fat_g: 5 });
    if (lower.includes('rice')) items.push({ name: "White Cooked Rice (1 cup)", calories: 200, protein_g: 4, carbs_g: 44, fat_g: 0.5 });
    if (lower.includes('banana')) items.push({ name: "Large Banana", calories: 105, protein_g: 1.3, carbs_g: 27, fat_g: 0.3 });
    if (lower.includes('toast')) items.push({ name: "Whole Wheat Toast (1 slice)", calories: 80, protein_g: 3, carbs_g: 15, fat_g: 1 });
    if (lower.includes('shake')) items.push({ name: "Whey Protein Shake", calories: 160, protein_g: 25, carbs_g: 3, fat_g: 2 });
    if (items.length === 0) {
      items.push({ name: text, calories: 180, protein_g: 10, carbs_g: 25, fat_g: 4 });
    }
    return { type: "food", items };
  }
  
  if (lower.includes('run') || lower.includes('walk') || lower.includes('jog') || lower.includes('swim') || lower.includes('workout') || lower.includes('cycle') || lower.includes('gym')) {
    const items = [];
    if (lower.includes('run') || lower.includes('jog')) items.push({ name: "Outdoor Jogging", duration_minutes: 30, calories_burned: 320 });
    if (lower.includes('walk')) items.push({ name: "Power Walking", duration_minutes: 45, calories_burned: 180 });
    if (lower.includes('swim')) items.push({ name: "Laps Swimming", duration_minutes: 30, calories_burned: 280 });
    if (lower.includes('gym') || lower.includes('workout')) items.push({ name: "Resistance Strength Training", duration_minutes: 60, calories_burned: 240 });
    if (items.length === 0) {
      items.push({ name: text, duration_minutes: 30, calories_burned: 200 });
    }
    return { type: "exercise", items };
  }

  return { type: "unknown", message: "I couldn't identify any specific food or exercise in your message. Enter a Gemini Key in Settings to get real-time AI capabilities!" };
}

