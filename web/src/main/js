  const startOfCurrentWeek = new Date(today.getTime() - currentDayOfWeek * 24 * 60 * 60 * 1000);
  startOfCurrentWeek.setHours(0,0,0,0);
  
  const weekStart = new Date(startOfCurrentWeek.getTime() - tabIndex * 7 * 24 * 60 * 60 * 1000);
  const weekDays = [];
  for (let i = 0; i < 7; i++) {
